{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "curl -L https://github.com/gohugoio/hugo/releases/download/v0.162.0/hugo_extended_0.162.0_linux-amd64.tar.gz -o /tmp/hugo.tar.gz && tar -xzf /tmp/hugo.tar.gz -C /tmp && /tmp/hugo --minify && pnpm run pagefind",
  "outputDirectory": "public"
}
